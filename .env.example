# UstoGo Backend — environment template (docs/DEPLOYMENT.md §3).
# Copy to .env. The local defaults below match docker-compose.yml and work as-is.
# Never commit a real secret: .env is gitignored, this file is not.

# ---------- Docker host ports ----------
# Only the *host* side of the port mapping; container ports never change. Override these
# if another stack on your machine already holds a default. Anything you change here must
# be reflected in DATABASE_URL, S3_ENDPOINT, REDIS_URL and MAIL_PORT below.
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# ---------- Application ----------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000

# ---------- Database ----------
DATABASE_URL=postgresql://ustogo:ustogo@localhost:5432/ustogo?schema=public
DATABASE_POOL_SIZE=20

# ---------- JWT ----------
# Access and refresh secrets are independent 64-byte random values.
# The values below are throwaway local-development placeholders — they are published
# in this repository and therefore public. Generate real ones for any shared
# environment, and load them from a secret manager:
#   node -e "console.log(require('node:crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=dev_only_access_secret_not_for_any_shared_environment_0000000000000000
JWT_REFRESH_SECRET=dev_only_refresh_secret_not_for_any_shared_environment_1111111111111111
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=ustogo-api
JWT_AUDIENCE=ustogo-clients
BCRYPT_ROUNDS=12

# ---------- Object storage (MinIO locally) ----------
# Credentials match the MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in docker-compose.yml.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ustogo-local
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PRESIGN_TTL=900

# ---------- Mail (Mailpit locally) ----------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="UstoGo <no-reply@ustogo.app>"

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- Throttling ----------
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ---------- Observability ----------
LOG_LEVEL=debug
SENTRY_DSN=
SWAGGER_ENABLED=true
