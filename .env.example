# UstoGo Backend — environment template (docs/DEPLOYMENT.md §3).
# Copy to .env. The local defaults below match docker-compose.yml and work as-is.
# Never commit a real secret: .env is gitignored, this file is not.

# ---------- Application ----------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000

# ---------- Database ----------
DATABASE_URL=postgresql://ustogo:ustogo@localhost:5432/ustogo?schema=public
DATABASE_POOL_SIZE=20

# ---------- JWT ----------
# Access and refresh secrets are independent 64-byte random values.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=ustogo-api
JWT_AUDIENCE=ustogo-clients
BCRYPT_ROUNDS=12

# ---------- Object storage (MinIO locally) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ustogo-local
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGN_TTL=900

# ---------- Mail (Mailpit locally) ----------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="UstoGo <no-reply@ustogo.app>"

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- Throttling ----------
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ---------- Observability ----------
LOG_LEVEL=debug
SENTRY_DSN=
SWAGGER_ENABLED=true
