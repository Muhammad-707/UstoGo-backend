{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Public — no authentication required. Answers 200 whenever the process is running, and checks nothing else. A liveness probe that consults a dependency restarts the application when the dependency fails, which loses the instance and fixes nothing.",
        "operationId": "liveness",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponseDto"
                }
              }
            }
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "Health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Public — no authentication required. Verifies that PostgreSQL and the object store are reachable. Returns 503 while any dependency is down, so the load balancer stops routing before the instance stops answering.",
        "operationId": "readiness",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "SERVICE_UNAVAILABLE — `details` names each failing dependency",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "Health"
        ]
      }
    },
    "/auth/register/client": {
      "post": {
        "description": "Public — no authentication required. Creates an ACTIVE client account and returns a token pair. The role is a server-side constant: a `role` property in the body is rejected by the validation whitelist, and no code path creates an administrator.",
        "operationId": "registerClient",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterClientDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "EMAIL_ALREADY_EXISTS | PHONE_ALREADY_EXISTS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "422": {
            "description": "VALIDATION_FAILED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "TOO_MANY_REQUESTS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Register a client",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/register/master": {
      "post": {
        "description": "Public — no authentication required. Creates the account and a MasterProfile with approvalStatus PENDING and isActive false. The master is invisible in search until an administrator approves them. Phone, city, display name and timezone are required.",
        "operationId": "registerMaster",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterMasterDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "EMAIL_ALREADY_EXISTS | PHONE_ALREADY_EXISTS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "422": {
            "description": "VALIDATION_FAILED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "TOO_MANY_REQUESTS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Register a master",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "description": "Public — no authentication required. An unknown email and a wrong password produce the same 401 and a comparable response time, so this endpoint cannot be used to discover which addresses are registered. Account status is reported only after the password verifies, for the same reason.",
        "operationId": "login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "INVALID_CREDENTIALS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "ACCOUNT_BLOCKED | ACCOUNT_INACTIVE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "422": {
            "description": "VALIDATION_FAILED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "TOO_MANY_REQUESTS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Log in",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "description": "Public — the refresh token itself is the credential. Each refresh consumes the presented token and issues its successor in the same family. **Serialise your refreshes**: concurrent calls with the same token leave exactly one winner, and presenting an already-consumed token revokes every session in the family and returns REFRESH_TOKEN_REUSED. On that error, clear all credentials and re-login — do not retry.",
        "operationId": "refresh",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "INVALID_REFRESH_TOKEN | REFRESH_TOKEN_REUSED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "TOO_MANY_REQUESTS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Rotate the token pair",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "description": "Idempotent — an unknown or already-revoked token still returns 204.",
        "operationId": "logout",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": ""
          },
          "401": {
            "description": "UNAUTHORIZED | TOKEN_EXPIRED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN | ACCOUNT_BLOCKED | ACCOUNT_INACTIVE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Revoke the presented refresh token",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/logout-all": {
      "post": {
        "description": "Idempotent. Signs the caller out of every device, including this one.",
        "operationId": "logoutAll",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          },
          "401": {
            "description": "UNAUTHORIZED | TOKEN_EXPIRED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN | ACCOUNT_BLOCKED | ACCOUNT_INACTIVE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Revoke every session of the caller",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/forgot-password": {
      "post": {
        "description": "Public — no authentication required. **Always** returns 202, whether or not the address is registered; answering differently would reveal which addresses have accounts. Any previously issued reset link stops working.",
        "operationId": "forgotPassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": ""
          },
          "429": {
            "description": "TOO_MANY_REQUESTS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Request a password reset link",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/reset-password": {
      "post": {
        "description": "Public — the token is the credential. Single use. Revokes **every** session, including any the caller currently holds: a reset is what someone does when they believe the account is compromised.",
        "operationId": "resetPassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": ""
          },
          "400": {
            "description": "INVALID_RESET_TOKEN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "422": {
            "description": "VALIDATION_FAILED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "TOO_MANY_REQUESTS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Set a new password using an emailed token",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/password": {
      "patch": {
        "description": "Revokes every other session but keeps this one, so changing a password does not sign you out of the device you changed it on.",
        "operationId": "changePassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": ""
          },
          "401": {
            "description": "INVALID_CREDENTIALS\n\nUNAUTHORIZED | TOKEN_EXPIRED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN | ACCOUNT_BLOCKED | ACCOUNT_INACTIVE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "422": {
            "description": "VALIDATION_FAILED | PASSWORD_REUSED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Change the caller’s password",
        "tags": [
          "Auth"
        ]
      }
    }
  },
  "info": {
    "title": "UstoGo API",
    "description": "Marketplace API connecting clients with professional craftsmen.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Auth",
      "description": "Registration, login, sessions, passwords"
    },
    {
      "name": "Users",
      "description": "Own profile and account"
    },
    {
      "name": "Files",
      "description": "Presigned uploads"
    },
    {
      "name": "Categories",
      "description": "Public category tree"
    },
    {
      "name": "Masters",
      "description": "Public master discovery"
    },
    {
      "name": "Master Cabinet",
      "description": "Master self-service (role: MASTER)"
    },
    {
      "name": "Bookings",
      "description": "Booking lifecycle"
    },
    {
      "name": "Reviews",
      "description": "Ratings and reviews"
    },
    {
      "name": "Notifications",
      "description": "In-app notifications"
    },
    {
      "name": "Chat",
      "description": "Client ↔ master messaging"
    },
    {
      "name": "Banners",
      "description": "Public promotional content"
    },
    {
      "name": "Admin",
      "description": "Administration and moderation (role: ADMIN)"
    },
    {
      "name": "Health",
      "description": "Liveness and readiness"
    }
  ],
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local"
    },
    {
      "url": "https://api.staging.ustogo.app",
      "description": "Staging"
    },
    {
      "url": "https://api.ustogo.app",
      "description": "Production"
    }
  ],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Access token from /auth/login"
      }
    },
    "schemas": {
      "LivenessResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok",
            "description": "Always \"ok\" — the process answered"
          },
          "uptimeSeconds": {
            "type": "number",
            "example": 12.482,
            "description": "Process uptime in seconds"
          },
          "timestamp": {
            "type": "string",
            "example": "2026-07-29T10:15:00.000Z"
          }
        },
        "required": [
          "status",
          "uptimeSeconds",
          "timestamp"
        ]
      },
      "HealthStatus": {
        "type": "string",
        "enum": [
          "up",
          "down"
        ]
      },
      "HealthCheckDto": {
        "type": "object",
        "properties": {
          "status": {
            "example": "up",
            "allOf": [
              {
                "$ref": "#/components/schemas/HealthStatus"
              }
            ]
          },
          "latencyMs": {
            "type": "number",
            "example": 3,
            "description": "How long the probe took, in milliseconds"
          }
        },
        "required": [
          "status",
          "latencyMs"
        ]
      },
      "ReadinessResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "checks": {
            "description": "One entry per dependency, keyed by name",
            "example": {
              "database": {
                "status": "up",
                "latencyMs": 3
              },
              "objectStorage": {
                "status": "up",
                "latencyMs": 11
              }
            },
            "allOf": [
              {
                "$ref": "#/components/schemas/HealthCheckDto"
              }
            ]
          },
          "timestamp": {
            "type": "string",
            "example": "2026-07-29T10:15:00.000Z"
          }
        },
        "required": [
          "status",
          "checks",
          "timestamp"
        ]
      },
      "ErrorDetailDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "email",
            "description": "Dot path; array elements use indices"
          },
          "constraints": {
            "example": [
              "email must be an email"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "field",
          "constraints"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 409,
            "description": "Mirrors the HTTP response status"
          },
          "code": {
            "type": "string",
            "example": "SLOT_NOT_AVAILABLE",
            "description": "Stable identifier. Clients branch on this, never on `message`."
          },
          "message": {
            "type": "string",
            "example": "The requested time slot is no longer available.",
            "description": "English, developer-facing. Clients localise from `code`."
          },
          "details": {
            "description": "Populated for 422; empty otherwise",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorDetailDto"
            }
          },
          "path": {
            "type": "string",
            "example": "/api/v1/bookings",
            "description": "Path without the query string"
          },
          "timestamp": {
            "type": "string",
            "example": "2026-07-29T10:15:00.000Z",
            "description": "ISO-8601 UTC"
          },
          "requestId": {
            "type": "string",
            "example": "3f1a2b8c-9d4e-4f60-8a1b-2c3d4e5f6a7b",
            "description": "Correlates to logs and to the X-Request-Id header"
          }
        },
        "required": [
          "statusCode",
          "code",
          "message",
          "details",
          "path",
          "timestamp",
          "requestId"
        ]
      },
      "RegisterClientDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "aziz@example.com",
            "maxLength": 255
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72,
            "example": "correcthorse7",
            "description": "At least 8 characters, with at least one letter and one digit."
          },
          "firstName": {
            "type": "string",
            "example": "Aziz",
            "minLength": 2,
            "maxLength": 100
          },
          "lastName": {
            "type": "string",
            "example": "Karimov",
            "minLength": 2,
            "maxLength": 100
          },
          "phone": {
            "type": "string",
            "example": "+998901234567",
            "description": "E.164"
          },
          "cityId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "email",
          "password",
          "firstName",
          "lastName"
        ]
      },
      "UserRole": {
        "type": "string",
        "enum": [
          "ADMIN",
          "CLIENT",
          "MASTER"
        ]
      },
      "UserStatus": {
        "type": "string",
        "enum": [
          "ACTIVE",
          "INACTIVE",
          "BLOCKED"
        ]
      },
      "AuthUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "example": "aziz@example.com"
          },
          "role": {
            "example": "CLIENT",
            "allOf": [
              {
                "$ref": "#/components/schemas/UserRole"
              }
            ]
          },
          "status": {
            "example": "ACTIVE",
            "allOf": [
              {
                "$ref": "#/components/schemas/UserStatus"
              }
            ]
          },
          "phone": {
            "type": "object",
            "example": "+998901234567",
            "nullable": true
          }
        },
        "required": [
          "id",
          "email",
          "role",
          "status"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/AuthUserDto"
          },
          "accessToken": {
            "type": "string",
            "description": "Bearer JWT. Send as `Authorization: Bearer <token>`."
          },
          "refreshToken": {
            "type": "string",
            "description": "Opaque rotating token. Returned once and never again — store it in the most protected storage available and send it only to /auth/refresh."
          },
          "expiresIn": {
            "type": "number",
            "example": 900,
            "description": "Access-token lifetime in seconds"
          }
        },
        "required": [
          "user",
          "accessToken",
          "refreshToken",
          "expiresIn"
        ]
      },
      "RegisterMasterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "aziz@example.com",
            "maxLength": 255
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72,
            "example": "correcthorse7",
            "description": "At least 8 characters, with at least one letter and one digit."
          },
          "firstName": {
            "type": "string",
            "example": "Aziz",
            "minLength": 2,
            "maxLength": 100
          },
          "lastName": {
            "type": "string",
            "example": "Karimov",
            "minLength": 2,
            "maxLength": 100
          },
          "phone": {
            "type": "string",
            "example": "+998901234567",
            "description": "E.164 — required for masters"
          },
          "cityId": {
            "type": "string",
            "format": "uuid",
            "description": "Required for masters"
          },
          "displayName": {
            "type": "string",
            "example": "Aziz — Plumbing & Heating",
            "minLength": 2,
            "maxLength": 150
          },
          "timezone": {
            "type": "string",
            "example": "Asia/Tashkent",
            "description": "IANA time zone"
          },
          "bio": {
            "type": "string",
            "maxLength": 2000
          },
          "yearsOfExperience": {
            "type": "number",
            "minimum": 0,
            "maximum": 70,
            "example": 8
          }
