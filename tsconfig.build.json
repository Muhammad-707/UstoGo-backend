{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    // Must live inside outDir. nest-cli.json deletes dist/ before every build; a build
    // info file surviving outside it convinces tsc nothing changed, so it emits nothing
    // and leaves a dist/ containing only the files touched since the last run.
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo",
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "test",
    "**/*.spec.ts",
    "**/*.e2e-spec.ts",
    "**/__tests__/**"
  ]
}
