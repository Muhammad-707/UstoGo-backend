// Authoritative model: docs/DATABASE.md. Any divergence between this file and that
// document is a defect (DATABASE.md, preamble).
//
// This migration covers §2 Enumerations, §3 Identity and §4 Sessions. Models whose
// dependencies have not landed are deliberately absent rather than stubbed:
//   - Certificate (§3.4) arrives with F-03 in Phase 2.
//   - MasterProfile.searchVector (§3.3) is a generated tsvector for full-text search,
//     added by raw SQL in 20260729204719_add_schedule_and_search_vector — Prisma
//     cannot express a `GENERATED ALWAYS AS (...) STORED` column, so it is queried
//     through `$queryRaw` in SearchService rather than the generated client. It *is*
//     declared below as `Unsupported("tsvector")` with a matching `dbgenerated()`
//     default purely so `prisma migrate dev`'s drift detection stops proposing to
//     drop the column and its GIN index on every unrelated migration.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, btree_gist, pg_trgm]
}

// ---------------------------------------------------------------------------
// §2 Enumerations
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  CLIENT
  MASTER

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED

  @@map("user_status")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("approval_status")
}

enum PriceType {
  FIXED
  HOURLY
  FROM

  @@map("price_type")
}

enum BookingStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  REJECTED
  EXPIRED
  CANCELLED_BY_CLIENT
  CANCELLED_BY_MASTER
  CANCELLED_BY_ADMIN

  @@map("booking_status")
}

enum ActorType {
  CLIENT
  MASTER
  ADMIN
  SYSTEM

  @@map("actor_type")
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_ACCEPTED
  BOOKING_REJECTED
  BOOKING_STARTED
  BOOKING_COMPLETED
  BOOKING_CANCELLED
  BOOKING_EXPIRED
  MASTER_REGISTERED
  MASTER_APPROVED
  MASTER_REJECTED
  MASTER_DEACTIVATED
  REVIEW_RECEIVED
  REVIEW_REPLIED
  REVIEW_INVITATION
  BOOKING_REMINDER
  MESSAGE_RECEIVED
  SYSTEM_ANNOUNCEMENT

  @@map("notification_type")
}

enum ReviewStatus {
  VISIBLE
  HIDDEN

  @@map("review_status")
}

enum BannerPosition {
  HOME_TOP
  HOME_MIDDLE
  CATEGORY_TOP

  @@map("banner_position")
}

enum FilePurpose {
  AVATAR
  CERTIFICATE
  BANNER
  MESSAGE_ATTACHMENT
  CATEGORY_ICON
  PORTFOLIO_IMAGE

  @@map("file_purpose")
}

enum AuditAction {
  MASTER_APPROVED
  MASTER_REJECTED
  MASTER_ACTIVATED
  MASTER_DEACTIVATED
  USER_BLOCKED
  USER_UNBLOCKED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_DEACTIVATED
  SERVICE_DEACTIVATED
  BOOKING_FORCE_CANCELLED
  REVIEW_HIDDEN
  REVIEW_UNHIDDEN
  BANNER_CREATED
  BANNER_UPDATED
  BANNER_DELETED
  NOTIFICATION_BROADCAST
  CONVERSATION_ACCESSED
  MASTER_STATS_ACCESSED
  CERTIFICATE_VERIFIED
  CERTIFICATE_REJECTED

  @@map("audit_action")
}

// ---------------------------------------------------------------------------
// §3 Identity
// ---------------------------------------------------------------------------

/// §3.1. Uniqueness on email and phone is a *partial* unique index scoped to live
/// rows, so a soft-deleted account releases its address. Prisma cannot express a
/// partial unique index, so both are created as raw SQL in the migration and are
/// deliberately not declared @unique here.
model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @db.Citext
  phone           String?    @db.VarChar(20)
  passwordHash    String     @map("password_hash") @db.VarChar(72)
  role            UserRole
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  /// Phase 6. AES-256-GCM ciphertext (`iv.authTag.ciphertext`, base64url), never
  /// plaintext — the one stored secret this schema keeps recoverable rather than
  /// hashed, because a TOTP code has to be verified against it, not merely compared.
  /// Set as soon as enrollment starts; `totpEnabledAt` is what gates login.
  totpSecret      String?    @map("totp_secret") @db.VarChar(255)
  totpEnabledAt   DateTime?  @map("totp_enabled_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)

  clientProfile           ClientProfile?
  masterProfile           MasterProfile?
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  twoFactorChallenges     TwoFactorChallenge[]
  idempotencyKeys         IdempotencyKey[]
  approvedMasters         MasterProfile[]          @relation("MasterApprovedBy")
  uploadedFiles           File[]
  auditLogs               AuditLog[]
  verifiedCertificates    Certificate[]            @relation("CertificateVerifiedBy")
  notifications           Notification[]
  hiddenReviews           Review[]                 @relation("ReviewHiddenBy")
  messages                Message[]
  createdBanners          Banner[]

  @@index([role, status])
  @@index([createdAt])
  @@map("users")
}

/// §3.2
model ClientProfile {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @map("user_id") @db.Uuid
  firstName      String    @map("first_name") @db.VarChar(100)
  lastName       String    @map("last_name") @db.VarChar(100)
  cityId         String?   @map("city_id") @db.Uuid
  avatarFileId   String?   @map("avatar_file_id") @db.Uuid
  defaultAddress String?   @map("default_address") @db.VarChar(500)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  city   City? @relation(fields: [cityId], references: [id], onDelete: Restrict)
  avatar File? @relation("ClientAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)

  bookings      Booking[]
  reviews       Review[]
  conversations Conversation[]
  favorites     Favorite[]

  @@index([cityId])
  @@map("client_profiles")
}

/// A client's bookmarked master — purely a saved-for-later list, no business rule
/// beyond "the client added it." Not the same as a booking or review relationship.
model Favorite {
  id              String   @id @default(uuid()) @db.Uuid
  clientProfileId String   @map("client_profile_id") @db.Uuid
  masterProfileId String   @map("master_profile_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  clientProfile ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  masterProfile MasterProfile @relation(fields: [masterProfileId], references: [id], onDelete: Cascade)

  @@unique([clientProfileId, masterProfileId])
  @@index([masterProfileId])
  @@map("favorites")
}

/// §3.3. ratingAverage, ratingCount and completedBookingsCount are denormalised and
/// written only inside the transaction that causes the change; a nightly job
/// reconciles them and logs drift as an error.
model MasterProfile {
  id                     String                   @id @default(uuid()) @db.Uuid
  userId                 String                   @unique @map("user_id") @db.Uuid
  firstName              String                   @map("first_name") @db.VarChar(100)
  lastName               String                   @map("last_name") @db.VarChar(100)
  displayName            String                   @map("display_name") @db.VarChar(150)
  bio                    String?
  yearsOfExperience      Int                      @default(0) @map("years_of_experience") @db.SmallInt
  cityId                 String                   @map("city_id") @db.Uuid
  serviceRadiusKm        Int                      @default(15) @map("service_radius_km") @db.SmallInt
  timezone               String                   @db.VarChar(64)
  avatarFileId           String?                  @map("avatar_file_id") @db.Uuid
  bannerFileId           String?                  @map("banner_file_id") @db.Uuid
  /// The master's WhatsApp number, E.164. Defaults to their registration phone and is
  /// the number clients reach them on directly — the marketplace's primary channel.
  /// Only ever published when `whatsappEnabled` is true. Changing it sets
  /// `whatsappChangedAt` (24-hour cooldown).
  whatsappPhone          String?                  @map("whatsapp_phone") @db.VarChar(20)
  whatsappEnabled        Boolean                  @default(true) @map("whatsapp_enabled")
  whatsappChangedAt      DateTime?                @map("whatsapp_changed_at") @db.Timestamptz(3)
  approvalStatus         ApprovalStatus           @default(PENDING) @map("approval_status")
  rejectionReason        String?                  @map("rejection_reason") @db.VarChar(500)
  approvedAt             DateTime?                @map("approved_at") @db.Timestamptz(3)
  approvedByUserId       String?                  @map("approved_by_user_id") @db.Uuid
  isActive               Boolean                  @default(false) @map("is_active")
  profileViews           Int                      @default(0) @map("profile_views")
  ratingAverage          Decimal                  @default(0.00) @map("rating_average") @db.Decimal(3, 2)
  ratingCount            Int                      @default(0) @map("rating_count")
  completedBookingsCount Int                      @default(0) @map("completed_bookings_count")
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt              DateTime?                @map("deleted_at") @db.Timestamptz(3)
  /// §3.3: `GENERATED ALWAYS AS (...) STORED`, added by raw SQL in
  /// 20260729204719_add_schedule_and_search_vector. Prisma cannot express the
  /// generation expression itself, so this is declared `Unsupported` purely so
  /// `prisma migrate dev`'s drift detection stops treating the column (and its GIN
  /// index below) as undeclared and proposing to drop both on every unrelated
  /// migration — a recurring footgun documented in STATUS.md, hit and hand-fixed at
  /// least three times. Still queried through `$queryRaw` in SearchService, never
  /// through the generated client.
  searchVector           Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('simple'::regconfig, (COALESCE(display_name, ''::character varying))::text), 'A'::\"char\") || setweight(to_tsvector('simple'::regconfig, COALESCE(bio, ''::text)), 'B'::\"char\"))")) @map("search_vector")

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  city       City  @relation(fields: [cityId], references: [id], onDelete: Restrict)
  approvedBy User? @relation("MasterApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  avatar     File? @relation("MasterAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  banner     File? @relation("MasterBanner", fields: [bannerFileId], references: [id], onDelete: SetNull)

  categories         MasterCategory[]
  certificates       Certificate[]
  portfolioImages    PortfolioImage[]
  services           Service[]
  workingDays        WorkingDay[]
  scheduleExceptions ScheduleException[]
  bookings           Booking[]
  reviews            Review[]
  reviewReplies      ReviewReply[]
  conversations      Conversation[]
  favoritedBy        Favorite[]

  @@index([approvalStatus, isActive])
  @@index([cityId])
  @@index([ratingAverage(sort: Desc)])
  /// Search hot path (F-08): the sort columns of the two default orderings, prefixed
  /// by the mandatory approval/active filter so the planner walks one composite index
  /// in order instead of sorting every approved master. The `deletedAt`-covering index
  /// exists so the `count(*)` behind search pagination is an index-only scan.
  @@index([approvalStatus, isActive, createdAt(sort: Desc)])
  @@index([approvalStatus, isActive, ratingAverage(sort: Desc)])
  @@index([approvalStatus, isActive, deletedAt])
  /// Matches the GIN index created by raw SQL alongside `searchVector` above — `map`
  /// pins the name to what already exists in every deployed database so this
  /// declaration reconciles with migration history instead of describing a new index.
  @@index([searchVector], map: "master_profiles_search_vector_idx", type: Gin)
  /// Same reconciliation for the admin masters listing's `ILIKE` trigram index
  /// (20260801_add_search_performance_indexes) — `pg_trgm`'s `gin_trgm_ops` operator
  /// class needs `ops: raw(...)`, available now that `postgresqlExtensions` is enabled.
  @@index([displayName(ops: raw("gin_trgm_ops"))], map: "master_profiles_display_name_trgm_idx", type: Gin)
  @@map("master_profiles")
}

/// §6.1. The weekly template; overlap within a weekday is rejected at the service
/// layer (`SCHEDULE_OVERLAP`) and the whole set is replaced atomically on `PUT`.
model WorkingDay {
  id              String   @id @default(uuid()) @db.Uuid
  masterProfileId String   @map("master_profile_id") @db.Uuid
  weekday         Int      @db.SmallInt
  startTime       DateTime @map("start_time") @db.Time
  endTime         DateTime @map("end_time") @db.Time
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  masterProfile MasterProfile @relation(fields: [masterProfileId], references: [id], onDelete: Cascade)

  @@index([masterProfileId, weekday])
  @@map("working_days")
}

/// §6.2. A date-specific override of the weekly template — a day off or custom hours.
/// One row per (masterProfileId, date).
model ScheduleException {
  id              String    @id @default(uuid()) @db.Uuid
  masterProfileId String    @map("master_profile_id") @db.Uuid
  date            DateTime  @db.Date
  isDayOff        Boolean   @map("is_day_off")
  startTime       DateTime? @map("start_time") @db.Time
  endTime         DateTime? @map("end_time") @db.Time
  note            String?   @db.VarChar(500)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  masterProfile MasterProfile @relation(fields: [masterProfileId], references: [id], onDelete: Cascade)

  @@unique([masterProfileId, date])
  @@map("schedule_exceptions")
}

/// §3.4. Deletion is soft — a certificate referenced by a past moderation decision
/// must remain reconstructable. `verifiedAt` is unused in v1 (manual review only) and
/// exists so automated verification (B-10) is an additive change.
model Certificate {
  id               String    @id @default(uuid()) @db.Uuid
  masterProfileId  String    @map("master_profile_id") @db.Uuid
  fileId           String    @map("file_id") @db.Uuid
  title            String    @db.VarChar(200)
  issuedBy         String?   @map("issued_by") @db.VarChar(200)
  issuedAt         DateTime? @map("issued_at") @db.Date
  verifiedAt       DateTime? @map("verified_at") @db.Timestamptz(3)
  verifiedByUserId String?   @map("verified_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)

  masterProfile MasterProfile @relation(fields: [masterProfileId], references: [id], onDelete: Cascade)
  file          File          @relation(fields: [fileId], references: [id], onDelete: Restrict)
  verifiedBy    User?         @relation("CertificateVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@index([masterProfileId, deletedAt])
  @@map("certificates")
}

/// B-45. A master's work-showcase gallery — photos of finished jobs, shown on the
/// public profile. Ordered by `sortOrder`, capped at `PORTFOLIO_IMAGE_LIMIT` per master
/// (masters.constants.ts) so the public profile projection stays bounded without a
/// second paginated endpoint for what is, in practice, a handful of highlight photos.
model PortfolioImage {
  id              String    @id @default(uuid()) @db.Uuid
  masterProfileId String    @map("master_profile_id") @db.Uuid
  fileId          String    @map("file_id") @db.Uuid
  caption         String?   @db.VarChar(200)
  sortOrder       Int       @default(0) @map("sort_order")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  masterProfile MasterProfile @relation(fields: [masterProfileId], references: [id], onDelete: Cascade)
  file          File          @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([masterProfileId, deletedAt, sortOrder])
  @@map("portfolio_images")
}

/// §5.2. Unique per (masterProfileId, categoryId); attaching an already-attached
/// category is idempotent at the service layer rather than a 409, since the caller's
/// intent — "this category should be attached" — is already satisfied.
model MasterCategory {
  id              String   @id @default(uuid()) @db.Uuid
  masterProfileId String   @map("master_profile_id") @db.Uuid
  categoryId      String   @map("category_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  masterProfile MasterProfile @relation(fields: [masterProfileId], references: [id], onDelete: Cascade)
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([masterProfileId, categoryId])
  @@map("master_categories")
}

/// §5.3. `currency` is deployment-constant (BR-24), not per-row — it is stored per row
/// only because a price is meaningless without the unit it was quoted in.
model Service {
  id              String    @id @default(uuid()) @db.Uuid
  masterProfileId String    @map("master_profile_id") @db.Uuid
  categoryId      String    @map("category_id") @db.Uuid
  title           String    @db.VarChar(200)
  description     String?
  priceType       PriceType @map("price_type")
  price           Decimal   @db.Decimal(12, 2)
  currency        String    @db.Char(3)
  durationMinutes Int       @map("duration_minutes")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  masterProfile MasterProfile @relation(fields: [masterProfileId], references: [id], onDelete: Cascade)
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  bookings      Booking[]

  @@index([masterProfileId, isActive])
  @@index([categoryId, isActive])
  @@index([price])
  @@map("services")
}

/// §3.5. Seeded reference data — no soft delete; withdraw a city with isActive.
model City {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(150)
  /// Tajik/Russian display names; null falls back to `name` (English).
  nameTj    String?  @map("name_tj") @db.VarChar(150)
  nameRu    String?  @map("name_ru") @db.VarChar(150)
  slug      String   @unique @db.VarChar(150)
  region    String?  @db.VarChar(150)
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  clientProfiles ClientProfile[]
  masterProfiles MasterProfile[]
  districts      District[]
  bookings       Booking[]

  @@map("cities")
}

/// §3.6. Seeded reference data — the internal sub-divisions of a city (its districts
/// for Dushanbe, jamoats/mahallas elsewhere). Used by the booking address step: the
/// client picks the city at registration, then the district of that city when
/// requesting a service. No soft delete; withdraw a district with isActive.
model District {
  id        String   @id @default(uuid()) @db.Uuid
  cityId    String   @map("city_id") @db.Uuid
  /// Seeded in Tajik (the source data), so `name` doubles as the `tj` display value;
  /// `nameRu` is an optional override, null falls back to `name`.
  name      String   @db.VarChar(150)
  nameRu    String?  @map("name_ru") @db.VarChar(150)
  slug      String   @db.VarChar(150)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([cityId, slug])
  @@index([cityId, isActive, name])
  @@map("districts")
}

// ---------------------------------------------------------------------------
// §4 Sessions and Tokens
// ---------------------------------------------------------------------------

/// §4.1. Only the SHA-256 hash of a token is stored. Rows are hard-deleted by a
/// nightly job once expiresAt is more than 30 days past.
model RefreshToken {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.VarChar(128)
  familyId      String    @map("family_id") @db.Uuid
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason") @db.VarChar(100)
  deviceId      String?   @map("device_id") @db.VarChar(200)
  userAgent     String?   @map("user_agent") @db.VarChar(500)
  ipAddress     String?   @map("ip_address") @db.VarChar(45)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// §4.2. The raw token exists only in the outbound email.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// §4.3 (Phase 6). Same shape as PasswordResetToken — the raw token exists only in the
/// outbound email. One active token per user; issuing a new one invalidates the last.
model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

/// §4.4 (Phase 6). Issued after a password verifies for an account with TOTP enabled;
/// the raw token is the "first factor passed" credential — it authenticates nothing by
/// itself and is exchanged for a real session only alongside a valid TOTP code.
/// Five-minute lifetime, single use, same hash-only storage as every other token here.
model TwoFactorChallenge {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("two_factor_challenges")
}

/// §4.5 (Phase 6). One row per client-supplied `Idempotency-Key` on a decorated
/// mutating endpoint. `requestHash` (SHA-256 of method+path+body) detects a key reused
/// for a genuinely different request, which is a client bug, not a retry —
/// `IDEMPOTENCY_KEY_REUSED` rather than silently replaying the wrong response.
/// `responseStatus`/`responseBody` are null while the original request is still being
/// handled; the unique constraint on (userId, key) is what makes two concurrent
/// requests carrying the same key race on *inserting* this row rather than on running
/// the handler twice.
model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  key            String   @db.VarChar(200)
  method         String   @db.VarChar(10)
  path           String   @db.VarChar(300)
  requestHash    String   @map("request_hash") @db.VarChar(64)
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// §11 Files
// ---------------------------------------------------------------------------

/// §11. A row is created at presign time with isConfirmed = false and becomes usable
/// only after the server has read the stored object's real content type and size.
/// Unconfirmed rows older than 24 hours are hard-deleted by a nightly job, together
/// with any object that did get uploaded.
model File {
  id               String      @id @default(uuid()) @db.Uuid
  key              String      @unique @db.VarChar(500)
  bucket           String      @db.VarChar(100)
  mimeType         String      @map("mime_type") @db.VarChar(150)
  sizeBytes        BigInt      @map("size_bytes")
  purpose          FilePurpose
  uploadedByUserId String?     @map("uploaded_by_user_id") @db.Uuid
  isConfirmed      Boolean     @default(false) @map("is_confirmed")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt        DateTime?   @map("deleted_at") @db.Timestamptz(3)

  uploadedBy         User?               @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  clientAvatars      ClientProfile[]     @relation("ClientAvatar")
  masterAvatars      MasterProfile[]     @relation("MasterAvatar")
  masterBanners      MasterProfile[]     @relation("MasterBanner")
  categoryIcons      Category[]
  certificates       Certificate[]
  portfolioImages    PortfolioImage[]
  messageAttachments MessageAttachment[]
  banners            Banner[]

  @@index([uploadedByUserId])
  @@index([isConfirmed, createdAt])
  @@map("files")
}

// ---------------------------------------------------------------------------
// §13 Audit
// ---------------------------------------------------------------------------

/// §13. Append-only: no update or delete path exists in code, and the database role
/// has no DELETE grant on this table (SECURITY.md §2.9). `before`/`after` are optional
/// because a creation has no prior state and a delete has no resulting one.
model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  actorUserId String      @map("actor_user_id") @db.Uuid
  action      AuditAction
  entityType  String      @map("entity_type") @db.VarChar(60)
  entityId    String      @map("entity_id") @db.Uuid
  before      Json?
  after       Json?
  reason      String?     @db.VarChar(500)
  ipAddress   String?     @map("ip_address") @db.VarChar(45)
  userAgent   String?     @map("user_agent") @db.VarChar(500)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// §5 Catalogue
// ---------------------------------------------------------------------------

/// §5.1. `depth` and `parentId` are the tree; `depth` is denormalised and recomputed
/// for the whole subtree in one transaction whenever a category is reparented, so a
/// depth check never has to walk the tree at read time. `slug` has no update path in
/// code — immutable once created (FEATURES.md › F-05, MODULES.md › CategoriesModule).
model Category {
  id            String    @id @default(uuid()) @db.Uuid
  parentId      String?   @map("parent_id") @db.Uuid
  slug          String    @unique @db.VarChar(100)
  name          String    @db.VarChar(150)
  /// Tajik/Russian display copy; null falls back to `name`/`description` (English).
  nameTj        String?   @map("name_tj") @db.VarChar(150)
  nameRu        String?   @map("name_ru") @db.VarChar(150)
  description   String?
  descriptionTj String?   @map("description_tj")
  descriptionRu String?   @map("description_ru")
  iconFileId    String?   @map("icon_file_id") @db.Uuid
  depth         Int       @db.SmallInt
  sortOrder     Int       @default(0) @map("sort_order")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  parent   Category?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[]       @relation("CategoryTree")
  icon     File?            @relation(fields: [iconFileId], references: [id], onDelete: SetNull)
  masters  MasterCategory[]
  services Service[]

  @@index([parentId, sortOrder])
  @@index([isActive])
  @@map("categories")
}

// ---------------------------------------------------------------------------
// §7 Bookings
// ---------------------------------------------------------------------------

/// §7.1. `bookingNumber` is generated from `booking_number_seq` (raw SQL migration)
/// and formatted by the application, never by a Postgres default — the display
/// format (`UG-2026-000123`) needs the current year, which `DEFAULT` cannot express
/// without a stored function. Price/title/duration are snapshots: editing or
/// deleting the originating `Service` must never change a booking already made
/// (CLAUDE.md §9 common traps). The `bookings_no_overlap` GiST exclusion constraint
/// (added in raw SQL below) is the storage-layer guarantee against double-booking;
/// the `SERIALIZABLE` transaction in `BookingsService.accept` is the application-layer
/// one — both exist, and either alone would be insufficient.
model Booking {
  id                    String        @id @default(uuid()) @db.Uuid
  bookingNumber         String        @unique @map("booking_number") @db.VarChar(20)
  clientProfileId       String        @map("client_profile_id") @db.Uuid
  masterProfileId       String        @map("master_profile_id") @db.Uuid
  serviceId             String        @map("service_id") @db.Uuid
  cityId                String?       @map("city_id") @db.Uuid
  status                BookingStatus @default(PENDING)
  scheduledAt           DateTime      @map("scheduled_at") @db.Timestamptz(3)
  endsAt                DateTime      @map("ends_at") @db.Timestamptz(3)
  durationMinutes       Int           @map("duration_minutes")
  serviceTitle          String        @map("service_title") @db.VarChar(200)
  price                 Decimal       @db.Decimal(12, 2)
  priceType             PriceType     @map("price_type")
  currency              String        @db.Char(3)
  addressLine           String        @map("address_line") @db.VarChar(500)
  addressDistrict       String        @map("address_district") @db.VarChar(150)
  contactPhone          String?       @map("contact_phone") @db.VarChar(20)
  latitude              Decimal?      @db.Decimal(9, 6)
  longitude             Decimal?      @db.Decimal(9, 6)
  clientNote            String?       @map("client_note")
  acceptedAt            DateTime?     @map("accepted_at") @db.Timestamptz(3)
  startedAt             DateTime?     @map("started_at") @db.Timestamptz(3)
  completedAt           DateTime?     @map("completed_at") @db.Timestamptz(3)
  cancelledAt           DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason    String?       @map("cancellation_reason") @db.VarChar(500)
  cancelledByType       ActorType?    @map("cancelled_by_type")
  isLateCancellation    Boolean       @default(false) @map("is_late_cancellation")
  /// Set once on the client's first click of the master's WhatsApp link (P0) — the
  /// analytics signal that a client actually reached out off-platform.
  whatsappLinkClickedAt DateTime?     @map("whatsapp_link_clicked_at") @db.Timestamptz(3)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?     @map("deleted_at") @db.Timestamptz(3)

  clientProfile ClientProfile          @relation(fields: [clientProfileId], references: [id], onDelete: Restrict)
  masterProfile MasterProfile          @relation(fields: [masterProfileId], references: [id], onDelete: Restrict)
  service       Service                @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  city          City?                  @relation(fields: [cityId], references: [id], onDelete: SetNull)
  history       BookingStatusHistory[]
  review        Review?

  @@index([masterProfileId, status, scheduledAt])
  @@index([clientProfileId, status, scheduledAt])
  @@index([status, scheduledAt])
  @@index([scheduledAt])
  @@index([createdAt])
  @@index([cityId])
  @@map("bookings")
}

/// §7.2. Append-only — no update or delete path exists in code, matching `AuditLog`.
model BookingStatusHistory {
  id          String         @id @default(uuid()) @db.Uuid
  bookingId   String         @map("booking_id") @db.Uuid
  fromStatus  BookingStatus? @map("from_status")
  toStatus    BookingStatus  @map("to_status")
  actorType   ActorType      @map("actor_type")
  actorUserId String?        @map("actor_user_id") @db.Uuid
  reason      String?        @db.VarChar(500)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

// ---------------------------------------------------------------------------
// §8 Reviews
// ---------------------------------------------------------------------------

/// §8.1. `bookingId` is unique — the storage-layer backstop for BR-51 (one review
/// per booking) that `REVIEW_ALREADY_EXISTS` guards at the service layer first.
model Review {
  id              String       @id @default(uuid()) @db.Uuid
  bookingId       String       @unique @map("booking_id") @db.Uuid
  clientProfileId String       @map("client_profile_id") @db.Uuid
  masterProfileId String       @map("master_profile_id") @db.Uuid
  rating          Int          @db.SmallInt
  comment         String?      @db.VarChar(2000)
  /// NPS §6.1 (MASTER_PROMPT.md): 0–10, "how likely are you to recommend this master?"
  /// Independent of `rating` — a client can rate the work 5/5 and still be a passive on
  /// the recommend question. Both optional: a client who skips the survey still leaves
  /// a plain star review.
  npsScore        Int?         @map("nps_score") @db.SmallInt
  wouldRecommend  Boolean?     @map("would_recommend")
  status          ReviewStatus @default(VISIBLE)
  hiddenReason    String?      @map("hidden_reason") @db.VarChar(500)
  hiddenByUserId  String?      @map("hidden_by_user_id") @db.Uuid
  hiddenAt        DateTime?    @map("hidden_at") @db.Timestamptz(3)
  editedAt        DateTime?    @map("edited_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz(3)

  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  clientProfile ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Restrict)
  masterProfile MasterProfile @relation(fields: [masterProfileId], references: [id], onDelete: Restrict)
  hiddenBy      User?         @relation("ReviewHiddenBy", fields: [hiddenByUserId], references: [id], onDelete: SetNull)
  reply         ReviewReply?

  @@index([masterProfileId, status, createdAt(sort: Desc)])
  @@index([rating])
  @@map("reviews")
}

/// §8.2. One reply per review — enforced by the unique FK, same pattern as `Review.bookingId`.
model ReviewReply {
  id              String    @id @default(uuid()) @db.Uuid
  reviewId        String    @unique @map("review_id") @db.Uuid
  masterProfileId String    @map("master_profile_id") @db.Uuid
  body            String    @db.VarChar(2000)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  review        Review        @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  masterProfile MasterProfile @relation(fields: [masterProfileId], references: [id], onDelete: Cascade)

  @@map("review_replies")
}

// ---------------------------------------------------------------------------
// §10 Notifications
// ---------------------------------------------------------------------------

/// §10. `payload` holds only identifiers and display primitives — never a full
/// entity, never PII beyond a display name. Rows older than 180 days are
/// hard-deleted by a retention job; there is no update path other than `isRead`.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  payload   Json
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// §9 Messaging
// ---------------------------------------------------------------------------

/// §9.1. One conversation per (client, master) pair (BR-60); `POST /conversations`
/// is a find-or-create on the unique pair. `lastMessageAt`/`lastMessagePreview` are
/// denormalised for the list view and written only inside the transaction that
/// creates the message they summarise.
model Conversation {
  id                 String    @id @default(uuid()) @db.Uuid
  clientProfileId    String    @map("client_profile_id") @db.Uuid
  masterProfileId    String    @map("master_profile_id") @db.Uuid
  lastMessageAt      DateTime? @map("last_message_at") @db.Timestamptz(3)
  lastMessagePreview String?   @map("last_message_preview") @db.VarChar(200)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)

  clientProfile ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Restrict)
  masterProfile MasterProfile @relation(fields: [masterProfileId], references: [id], onDelete: Restrict)
  messages      Message[]

  @@unique([clientProfileId, masterProfileId])
  @@index([clientProfileId, lastMessageAt(sort: Desc)])
  @@index([masterProfileId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

/// §9.2. Immutable after send other than `readAt`; `DELETE /messages/:id` is a
/// sender-side soft delete, never a hard delete.
model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  senderUserId   String    @map("sender_user_id") @db.Uuid
  body           String    @db.VarChar(4000)
  readAt         DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]

  @@index([conversationId, createdAt(sort: Desc)])
  @@map("messages")
}

/// §9.3. References a `File` the sender already confirmed uploading; no cascade to
/// `File` itself — the object outlives an attachment row that stops being referenced.
model MessageAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  fileId    String   @map("file_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([messageId])
  @@map("message_attachments")
}

// ---------------------------------------------------------------------------
// §12 Banners
// ---------------------------------------------------------------------------

/// §12. References a `File` the admin already confirmed uploading with purpose
/// `BANNER`. Public reads filter to `isActive` and the current instant falling
/// inside [`startsAt`, `endsAt`] (either bound optional) — enforced in
/// `BannersService`, not here, because Prisma cannot express `now()` in a `@@index`
/// predicate; the index below only orders the candidate rows for that filter.
model Banner {
  id              String         @id @default(uuid()) @db.Uuid
  title           String         @db.VarChar(200)
  subtitle        String?        @db.VarChar(500)
  imageFileId     String         @map("image_file_id") @db.Uuid
  linkUrl         String?        @map("link_url") @db.VarChar(500)
  position        BannerPosition
  sortOrder       Int            @default(0) @map("sort_order")
  startsAt        DateTime?      @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime?      @map("ends_at") @db.Timestamptz(3)
  isActive        Boolean        @default(true) @map("is_active")
  createdByUserId String         @map("created_by_user_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz(3)

  image     File @relation(fields: [imageFileId], references: [id], onDelete: Restrict)
  createdBy User @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([position, isActive, sortOrder])
  @@map("banners")
}
